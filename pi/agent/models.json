          // Thinking mode sampling per https://huggingface.co/Qwen/Qwen3.8-27B
          // (temperature=1.0, top_p=0.95, top_k=20).
          "thinkingLevelMap": {
            "minimal": null,
            "low": "low",
            "medium": "medium",
            "high": null,  // no "high" effort; map to xhigh
            "xhigh": "xhigh",
            "max": null,
          },
          "samplingParams": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "presence_penalty": 0.0,
            "repetition_penalty": 1.0,
          },
        },
