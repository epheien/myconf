          "contextWindow": 524288,
          "maxTokens": 100000,
          "compat": {
            "thinkingFormat": "chat-template",
            "chatTemplateKwargs": {
              "reasoning_effort": { "$var": "thinking.effort" },
            },
          },
          "thinkingLevelMap": {
            "off": null,
            "minimal": null,
            "low": "low",
            "medium": null,
            "high": "high",
            "xhigh": null,
            "max": "max",
          },
