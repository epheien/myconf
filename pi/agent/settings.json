{
  "lastChangelogVersion": "0.83.0",
  "theme": "dark",
  "enableInstallTelemetry": false,
  "defaultProvider": "vllm",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "none",
  "quietStartup": false,
