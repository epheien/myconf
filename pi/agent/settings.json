{
  "lastChangelogVersion": "0.84.1",
  "theme": "dark",
  "enableInstallTelemetry": false,
  "defaultProvider": "vllm",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": true,
  "doubleEscapeAction": "none",
  "quietStartup": false,
  "outputPad": 0,
  "editorPaddingX": 0,
  "tuiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "showLastPrompt": false,
  "powerline": {
    "welcome": false,
    "disabledSegments": [
      "git"
    ],
    "separator": "dot",
    "placement": "below"
  },
  "packages": [
    "npm:pi-web-access",
    "git:github.com/obra/superpowers",
    "git:github.com/epheien/pi-permission-system",
    "git:github.com/epheien/pi-powerline-footer",
    "git:github.com/epheien/pi-attachments",
    "git:github.com/epheien/pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "git:github.com/epheien/pi-autocomplete-overlay",
    "npm:pi-hashline-edit"
  ],
  "subagents": {
    "abortAllOnInterrupt": true,
    "agentOverrides": {
      "reviewer": {
        "thinking": "max"
      }
    }
  }
}