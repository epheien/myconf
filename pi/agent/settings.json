  },
  "packages": [
    "npm:pi-web-access",
    "git:github.com/obra/superpowers",
    "git:github.com/epheien/pi-show-diffs",
    "git:github.com/epheien/pi-permission-system",
    "git:github.com/epheien/pi-powerline-footer",
    "npm:@juicesharp/rpiv-todo",
    "npm:@gotgenes/pi-subagents"
  ]
}
