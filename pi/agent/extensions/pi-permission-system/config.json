{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": false,
  "doublePressToConfirm": true,
  "keybindings": {
    "approveSession": [
      "Y",
      "s"
    ],
    "navUp": [
      "up",
      "k",
      "ctrl+p"
    ],
    "navDown": [
      "down",
      "j",
      "ctrl+n"
    ],
    "pageUp": [
      "ctrl+u"
    ],
    "pageDown": [
      "ctrl+d"
    ],
    "scrollTop": [
      "g"
    ],
    "scrollBottom": [
      "G"
    ],
    "toggleMode": [
      "ctrl+f",
      "tab"
    ],
    "yoloToggle": [
      "ctrl+y"
    ]
  },
  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "read": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "cd *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "rg *": "allow",
      "echo *": "allow",
      "sort *": "allow",
      "xargs *": "allow",
      "file *": "allow",
      "zcat *": "allow",
      "tr *": "allow",
      "less *": "allow",
      "more *": "allow",
      "fd *": "allow",
      "pwd *": "allow",
      "tree *": "allow",
      "git branch *": "allow",
      "npm list *": "allow",
      "npm outdated *": "allow",
      "yarn info *": "allow",
      "uname *": "allow",
      "whoami *": "allow",
      "date *": "allow",
      "uptime *": "allow",
      "rm -rf *": "ask",
      "sudo *": "ask",
      "chmod *": "ask",
      "chown *": "ask",
      "mkfs *": "deny",
      "dd if=* of=*": "deny",
      "git push *": "deny",
      "git push -f *": "deny",
      "git push --force *": "deny",
      "shutdown *": "ask",
      "reboot *": "ask"
    },
    "mcp": {
      "*": "ask"
    },
    "skill": {
      "*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/.cargo/registry/*": "allow",
      "~/.cache/*": "allow"
    }
  },
  "subagentPermission": {
    "write": "ask",
    "edit": "ask"
  }
}
