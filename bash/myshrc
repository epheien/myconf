stty -ixon

# 256color
if [ -n "$TMUX" ]; then
    : # .tmux.conf 负责设置, 这里不要修改 TERM
elif [[ "$TERM" == "screen-256color" ]]; then
    : # ignore
elif [[ "$TERM_PROGRAM" == "kitty" ]]; then
    : # 终端模拟器设置的 TERM, 保持原样, 一般是 kitty.conf 负责设置
elif [[ "$TERM_PROGRAM" == "ghostty" ]]; then
    # 使用 TERM=xterm-ghostty, 但是 ssh 下会有兼容问题, 所以用 alias 解决
    alias ssh='TERM=xterm-256color ssh'
else
    export TERM=xterm-256color
fi

if [ -n "$ZSH_VERSION" ]; then
    # XXX zsh shell
    # git config --global oh-my-zsh.hide-dirty 1
    __netns="$(ip netns identify $$ 2>/dev/null)"
    PROMPT='%(?:%{$fg_bold[green]%}➜ :%{$fg_bold[red]%}➜ [$?]) %M %{$fg[blue]%}$(date "+%m-%d %H:%M:%S.%3N") '
    if [ -n "$__netns" ]; then
        PROMPT="[${__netns}] $PROMPT"'%{$fg[cyan]%}%c%{$reset_color%}$(git_prompt_info)$ '
    else
        PROMPT="$PROMPT"'%{$fg[cyan]%}%c%{$reset_color%} $(git_prompt_info)$ '
    fi
    if [ -n "$SSH_CONNECTION" ]; then
        PROMPT='%(?:%{$fg_bold[yellow]%}➜ :%{$fg_bold[red]%}➜ [$?]) %M %{$fg[blue]%}$(date "+%m-%d %H:%M:%S.%3N") '
        PROMPT="$PROMPT"'%{$fg[cyan]%}%c%{$reset_color%} $(git_prompt_info)$ '
    fi
    # enable color support of ls and also add handy aliases
    alias ls='ls --color=auto'

    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'

    # some more ls aliases
    alias ll='ls -AlhF'
    alias la='ls -A'
    alias l='ls -CF'

    bindkey "^U" backward-kill-line
    # bash compatible ctrl-w
    unset WORDCHARS
    # 禁用历史共享
    unsetopt share_history

    # Uncomment the following line to disable auto-setting terminal title.
    # NOTE: 不禁用这个功能会导致在 tmux 里面的 nvim 的 terminal 有奇怪的行为
    DISABLE_AUTO_TITLE="true"
    # 设置标题栏
    if [[ "${TERM_PROGRAM}" == "alacritty" ]]; then
        precmd()
        {
            # output on which level (%L) this shell is running on.
            # append the current directory (%~), substitute home directories with a tilde.
            # "\a" bell (man 1 echo)
            # "print" must be used here; echo cannot handle prompt expansions (%L)
            print -Pn "\e]0;zsh %~\a"
        }

        preexec()
        {
            # output current executed command with parameters
            echo -en "\e]0;${1}\a"
        }
    elif [[ "$TERM_PROGRAM" == "kitty" ]]; then
        # 直接覆盖默认 title 实现
        title()
        {
            kitten @ set-window-title "$@"
        }
    elif [[ "$TERM_PROGRAM" == "ghostty" ]]; then
        # 使用 Ghostty 原生标签标题覆盖，而不是 OSC。活动标签的标题也
        # 是 macOS 窗口标题，这样不会被
        # ssh、tmux、nvim 等程序发送的标题控制序列覆盖。
        # 通过当前 TTY 定位 terminal，避免多个窗口时误改前台窗口。
        # 不带参数调用 title 可清除覆盖，恢复终端程序控制标题。
        title()
        {
            local terminal_tty process_id process_path parent_id ghostty_pid
            local -a process_ancestors

            terminal_tty=$(command tty) || return
            process_id=$$

            # tmux pane 的进程树不包含客户端；只有一个连接到当前 session
            # 的客户端时，改从客户端 PID/TTY 定位 Ghostty 实例。
            if [[ -n "$TMUX" ]]; then
                local session_id client_info
                session_id=$(tmux display-message -p '#{session_id}') || return
                client_info=$(tmux list-clients -t "$session_id" -F '#{client_pid} #{client_tty}') || return
                if [[ -z "$client_info" || "$client_info" == *$'\n'* ]]; then
                    print -u2 "title: 当前 tmux session 的客户端数量不是 1，无法确定 Ghostty 实例"
                    return 1
                fi
                process_id=${client_info%% *}
                terminal_tty=${client_info#* }
            fi

            # Ghostty 可以用 open -n 启动多个进程。沿当前 shell（或 tmux
            # 客户端）的父进程链寻找所属实例，不能使用按 app 路径寻址的
            # AppleScript，否则事件会被发给另一个 Ghostty 进程。
            while (( process_id > 1 )); do
                process_ancestors+=("$process_id")
                process_path=$(command ps -p "$process_id" -o comm= 2>/dev/null) || break
                if [[ "$process_path" == */Ghostty.app/Contents/MacOS/ghostty ]]; then
                    ghostty_pid=$process_id
                    break
                fi
                parent_id=$(command ps -p "$process_id" -o ppid= 2>/dev/null) || break
                (( parent_id > 0 )) || break
                process_id=$parent_id
            done

            if [[ -z "$ghostty_pid" ]]; then
                print -u2 "title: 无法从当前进程树确定 Ghostty 实例"
                return 1
            fi

            osascript -l JavaScript - "$ghostty_pid" "$terminal_tty" "$*" \
                "${process_ancestors[@]}" >/dev/null <<'JXA'
ObjC.import('ScriptingBridge');

function run(argv) {
    ObjC.bindFunction('objc_msgSend', ['bool', ['id', 'selector', 'id', 'id']]);

    const ghosttyPID = Number(argv[0]);
    const targetTTY = argv[1];
    const targetTitle = argv[2];
    const ancestorPIDs = new Set(argv.slice(3).map(Number));
    const app = $.SBApplication.applicationWithProcessIdentifier(ghosttyPID);
    const terminals = app.valueForKey('terminals');
    const matches = [];

    for (let i = 0; i < terminals.count; ++i) {
        const terminal = terminals.objectAtIndex(i);
        const tty = ObjC.unwrap(terminal.valueForKey('tty'));
        const foregroundPID = Number(ObjC.unwrap(terminal.valueForKey('pid')));
        if (tty === targetTTY || ancestorPIDs.has(foregroundPID)) {
            matches.push(terminal);
        }
    }

    if (matches.length !== 1) {
        throw new Error(
            `当前进程在 Ghostty ${ghosttyPID} 中匹配到 ${matches.length} 个 terminal: ${targetTTY}`
        );
    }

    // Scripting Bridge 在运行时生成 performAction:on:，JXA 无法直接看到
    // 这个方法；为 objc_msgSend 声明准确签名后再调用，避免 BOOL 返回值
    // 被 NSInvocation/performSelector 当成 Objective-C 对象。
    const selector = $.NSSelectorFromString('performAction:on:');
    const result = $.objc_msgSend(
        app,
        selector,
        $(`set_tab_title:${targetTitle}`),
        matches[0]
    );
    if (!result) throw new Error('Ghostty 拒绝了 set_tab_title action');
}
JXA
        }
    elif [[ -n "$TMUX" ]]; then
        title()
        {
            tmux rename-window -- "$*"
        }
    fi
    # command not found handler
    [ -f /etc/zsh_command_not_found ] && source /etc/zsh_command_not_found
else
    # XXX bash shell
    true
fi

